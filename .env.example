# Modo de acesso a dados:
#   mock -> backend simulado no navegador (localStorage), com as regras de negócio da especificação
#   http -> API REST real (ASP.NET Core), via proxy do Vite em /api
VITE_API_MODE=mock

# Base URL usada pelo cliente HTTP (modo http). Com o proxy do Vite, mantenha "/api".
VITE_API_BASE_URL=/api

# Endereço do backend usado pelo proxy do Vite (launchSettings.json -> perfil "http").
VITE_BACKEND_URL=http://localhost:5160
