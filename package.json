{
  "name": "court-manager-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Ottawa Tech \u2014 Sistema de Gest\u00e3o de Arena de Beach Tennis (frontend Angular)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/ng.mjs serve --host 0.0.0.0 --port 5173",
    "build": "node scripts/ng.mjs build",
    "preview": "vite preview --outDir dist/court-manager/browser",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "axios": "^1.20.0",
    "zod": "^4.6.5",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.0",
    "@angular/build": "21.2.28",
    "@angular/cli": "21.2.28",
    "@angular/compiler-cli": "21.2.25",
    "@playwright/test": "^1.58.0"
  }
}
